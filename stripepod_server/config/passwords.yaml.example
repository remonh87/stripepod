# Passwords and API keys for the server. Serverpod loads this file at startup;
# values are available through `session.passwords`.
#
# SETUP:
# 1. Copy this file:  cp config/passwords.yaml.example config/passwords.yaml
# 2. Replace every <PLACEHOLDER> below.
# 3. Never commit passwords.yaml (it is already in .gitignore).

# Used when running the server locally (`dart bin/main.dart`).
development:
  # Must match POSTGRES_PASSWORD of the `postgres` service in docker-compose.yaml.
  database: '<POSTGRES_PASSWORD from docker-compose.yaml, service "postgres">'

  # Must match --requirepass of the `redis` service in docker-compose.yaml.
  # Redis is disabled by default in config/development.yaml.
  redis: '<REDIS_PASSWORD from docker-compose.yaml, service "redis">'

  # Secret for the Serverpod service protocol (Insights). Use any random string
  # of at least 20 characters, for example the output of: openssl rand -base64 32
  serviceSecret: '<RANDOM_STRING_OF_AT_LEAST_20_CHARACTERS>'

  # Stripe Dashboard > Developers > API keys > Secret key (test mode).
  stripeServerKey: 'sk_test_<YOUR_STRIPE_SECRET_KEY>'

  # Signing secret printed by: stripe listen --forward-to http://localhost:8082/webhook
  stripeWebhookSecret: 'whsec_<YOUR_STRIPE_WEBHOOK_SIGNING_SECRET>'

# Used by `dart test`. The integration tests mock Stripe, so the Stripe values
# only need to be present, not real.
test:
  # Must match the `postgres_test` and `redis_test` services in docker-compose.yaml.
  database: '<POSTGRES_PASSWORD from docker-compose.yaml, service "postgres_test">'
  redis: '<REDIS_PASSWORD from docker-compose.yaml, service "redis_test">'
  serviceSecret: '<RANDOM_STRING_OF_AT_LEAST_20_CHARACTERS>'
  stripeServerKey: 'sk_test_<ANY_VALUE>'
  stripeWebhookSecret: 'whsec_<ANY_VALUE>'

# Only needed when you deploy. Do not reuse the local values.
staging:
  database: '<STAGING_DATABASE_PASSWORD>'
  serviceSecret: '<STAGING_SERVICE_SECRET>'
  stripeServerKey: 'sk_test_<YOUR_STRIPE_SECRET_KEY>'
  stripeWebhookSecret: 'whsec_<STAGING_WEBHOOK_SIGNING_SECRET>'

production:
  database: '<PRODUCTION_DATABASE_PASSWORD>'
  serviceSecret: '<PRODUCTION_SERVICE_SECRET>'
  stripeServerKey: 'sk_live_<YOUR_STRIPE_SECRET_KEY>'
  stripeWebhookSecret: 'whsec_<PRODUCTION_WEBHOOK_SIGNING_SECRET>'
